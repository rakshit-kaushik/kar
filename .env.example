# copy to .env; never commit .env
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# hosted model (caller simulator, teacher, fallback, baseline) — OpenAI-compatible
HOSTED_LLM_BASE_URL=https://api.anthropic.com/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=claude-sonnet-5-5
# local model via the proxy on 8001 (server itself on 8000)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=r3-voice-base
# ACTIVE endpoint every service reads; scripts/gpu_flip.sh rewrites these two lines
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=r3-voice-base
DATABASE_URL=postgresql://localhost:5432/r3
R3_ARTIFACTS=/Users/you/r3-artifacts

# proxy hosted fallback (plan T+13.5): re-issue a turn to HOSTED_LLM_* when the local server errors or has no first token in time
PROXY_FALLBACK=1
PROXY_FIRST_TOKEN_TIMEOUT_MS=2000

# Agent turn-taking (LiveKit defaults when unset; set from scripts/g1_block.sh measurements)
# AGENT_VAD_MIN_SILENCE=0.55   # Silero end-of-speech silence (s); 0.3 split phone numbers at their pauses
# AGENT_ENDPOINT_MIN=0.5       # endpointing min delay (s) after VAD end when the turn detector says "done"
# AGENT_ENDPOINT_MAX=3.0       # endpointing max delay (s) when it says "not done"
# AGENT_PREEMPTIVE=0           # 1 = start the LLM on the final transcript before the turn commits
