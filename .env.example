# copy to .env; never commit .env
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_MODEL=sonic-3.6
CARTESIA_VOICE=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# hosted model (caller simulator, teacher, fallback, baseline) — OpenAI-compatible
HOSTED_LLM_BASE_URL=https://api.anthropic.com/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=claude-sonnet-5-5
# local model via the proxy on 8001 (server itself on 8000)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=r3-voice-base
# ACTIVE endpoint every service reads; scripts/gpu_flip.sh rewrites these two lines
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=r3-voice-base
DATABASE_URL=postgresql://localhost:5432/r3
R3_ARTIFACTS=/Users/you/r3-artifacts

# proxy hosted fallback (plan T+13.5): re-issue a turn to HOSTED_LLM_* when the local server errors or has no first token in time
PROXY_FALLBACK=1
PROXY_FIRST_TOKEN_TIMEOUT_MS=2000   # hedge start; candidate with the trie fix: tool-call turns p95 1068 ms, spoken p95 185 ms (Nov 1 04:37, GPU free)

# Agent turn-taking (LiveKit defaults when unset; set from scripts/g1_block.sh measurements)
# Turn-taking knobs. Nov 1 A/B on simulated calls (2 calls vs 5, same completion): turn-taking overhead p50 864 -> 534 ms.
# Do not go below VAD 0.4: 0.3 split phone numbers at their pauses.
AGENT_VAD_MIN_SILENCE=0.4     # Silero end-of-speech silence (s); code default 0.55
AGENT_ENDPOINT_MIN=0.25       # endpointing min delay (s) after VAD end when the turn detector says "done"; default 0.5
AGENT_ENDPOINT_MAX=2.0        # endpointing max delay (s) when it says "not done"; default 3.0
AGENT_PREEMPTIVE=1            # start the LLM on the final transcript before the turn commits; default 0
# proxy: concurrent local generations served within budget (load test Nov 1: the SimpleEngine serializes, so 1); turns above it go to the hosted model when it is available
PROXY_ADMISSION_LIMIT=1

# TTS vendor: cartesia (default; CARTESIA_MODEL/CARTESIA_VOICE) or deepgram (Aura-2, same key as STT). Switch when Cartesia credits run out (402 quota_exceeded).
# AGENT_TTS=cartesia
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
AGENT_FILLER="One moment."   # quote values with spaces: the shell scripts source this file. spoken the moment a tool starts (once per caller turn, not while speaking, never in the chat context); empty = off
AGENT_LOOP_GUARD=1   # swallow an exact repeat of the previous line (rephrase, then handoff); 0 = off. services/agent/loopguard.py
AGENT_CLAIM_GUARD=1   # a transfer announced without request_handoff gets the handoff recorded first; 0 = off. services/agent/claimguard.py
AGENT_TOOL_RETRY=1   # executor retries a tool once on timeout/unavailable, same idempotency key (services/tools/executor.py)
AGENT_POLICY_HANDOFF=1   # contract rule: a fraud-category ticket ends in request_handoff(suspected_fraud); the application enforces it after the model's reply (services/agent/policy.py)
AGENT_LOOP_GUARD_HANDOFF_AFTER=3   # consecutive exact repeats before the loop guard hands off (below: rephrase); 2 was too eager on split caller utterances
SIM_TTS=auto                       # simulated caller voice: auto = Cartesia, Deepgram on a Cartesia error (402 quota, Nov 1); cartesia | deepgram force one
SIM_DEEPGRAM_VOICE=aura-2-orion-en # the fallback caller voice (the agent speaks aura-2-thalia-en)
# LOCAL_LLM_UPSTREAM_NAME=         # the name the local server answers to; discovered from its /v1/models when unset (a restart under a stale name 404s otherwise)
