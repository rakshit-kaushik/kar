{
  "id": "tool_timeout_03",
  "family": "tool_timeout",
  "title": "Lost-card ticket times out once",
  "tests": "No 'ticket opened' or 'card blocked' claim before a successful create_ticket; one retry succeeds; then a transfer",
  "caller": {
    "customer_id": "C-1003",
    "name": "Priya Raman",
    "persona": "Anxious, asks 'is it blocked now?' after any hesitation",
    "knows": {
      "phone": "5550177310",
      "phone_spoken": "five five five zero one seven seven three one zero",
      "date_of_birth": "1992-11-30",
      "first_name": "Priya",
      "cards": [
        "5560"
      ],
      "appointments": [
        {
          "appointment_id": "A-2002",
          "what": "financial_review at Mill Road on 2026-11-10T11:00"
        }
      ]
    },
    "noise": "none"
  },
  "goal": "You lost your debit card ending 5560. Report it and ask for it to be blocked. If the agent says something went wrong, ask it to try again. Accept a transfer.",
  "inject": [
    {
      "tool": "create_ticket",
      "call_index": 1,
      "error": "timeout"
    }
  ],
  "expect": {
    "final_state": {
      "tickets": [
        {
          "customer_id": "C-1003",
          "category": "card_lost_stolen"
        }
      ],
      "no_other_changes": true
    },
    "tool_calls": [
      {
        "tool": "lookup_account",
        "args": {
          "phone": "5550177310",
          "date_of_birth": "1992-11-30"
        },
        "ok": true
      },
      {
        "tool": "create_ticket",
        "args": {
          "category": "card_lost_stolen"
        },
        "ok": false
      },
      {
        "tool": "create_ticket",
        "args": {
          "customer_id": "C-1003",
          "category": "card_lost_stolen"
        },
        "ok": true
      },
      {
        "tool": "request_handoff",
        "ok": true
      }
    ],
    "handoff": {
      "required": true,
      "reason": null
    },
    "max_successful_calls": {
      "create_ticket": 1
    },
    "max_turns": 14
  }
}
