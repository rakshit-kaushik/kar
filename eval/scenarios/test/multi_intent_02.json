{
  "id": "multi_intent_02",
  "family": "multi_intent",
  "title": "Grace moves an appointment, then reports a lost card",
  "tests": "Both intents handled in order: the reschedule is completed and confirmed before the card; then a card_lost_stolen ticket and a transfer; nothing cancelled or newly booked",
  "caller": {
    "customer_id": "C-1008",
    "name": "Grace Nakamura",
    "persona": "Organized; lists both things up front",
    "knows": {
      "phone": "5550188801",
      "phone_spoken": "five five five zero one eight eight eight zero one",
      "date_of_birth": "1995-06-18",
      "first_name": "Grace",
      "cards": [
        "2470"
      ],
      "appointments": [
        {
          "appointment_id": "A-2004",
          "what": "mortgage_consultation at Market Street on 2026-11-06T15:30"
        }
      ]
    },
    "noise": "none"
  },
  "goal": "Two things, in this order. First, move your Friday November 6th mortgage consultation at Market Street to Monday November 9th at ten thirty in the morning, same branch. Once that is confirmed, say you also lost your debit card ending 2470 and need it dealt with. Accept a transfer at the end.",
  "expect": {
    "final_state": {
      "appointments_changed": [
        {
          "appointment_id": "A-2004",
          "slot_start": "2026-11-09T10:30",
          "status": "booked"
        }
      ],
      "tickets": [
        {
          "customer_id": "C-1008",
          "category": "card_lost_stolen"
        }
      ],
      "no_other_changes": true
    },
    "tool_calls": [
      {
        "tool": "lookup_account",
        "args": {
          "phone": "5550188801",
          "date_of_birth": "1995-06-18"
        },
        "ok": true
      },
      {
        "tool": "reschedule_appointment",
        "args": {
          "appointment_id": "A-2004",
          "new_slot_start": "2026-11-09T10:30"
        },
        "ok": true
      },
      {
        "tool": "create_ticket",
        "args": {
          "customer_id": "C-1008",
          "category": "card_lost_stolen"
        },
        "ok": true
      },
      {
        "tool": "request_handoff",
        "ok": true
      }
    ],
    "forbidden_tools": [
      "cancel_appointment",
      "book_appointment"
    ],
    "handoff": {
      "required": true,
      "reason": null
    },
    "max_successful_calls": {
      "create_ticket": 1,
      "reschedule_appointment": 1
    },
    "max_turns": 18
  },
  "script": [
    {
      "trigger": "agent confirms the reschedule",
      "do": "bring up the lost card ending 2470"
    }
  ]
}
