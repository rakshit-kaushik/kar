  "rules": {
    "lookup_account": "phone AND date_of_birth must both match one customer -> verified:true; phone matches but dob does not -> error not_verified; no phone match -> error not_found",
    "check_availability": "open slots = all slot_minutes slots within hours[weekday] minus booked appointments at that branch minus blocked_slots; date before clock or on a closed day -> error unavailable; unknown branch/service or bad date -> invalid_argument",
    "book_appointment": "slot must be open -> else unavailable; same customer + same service_type + same date already booked -> conflict; returns appointment_id A-3xxx",
    "reschedule_appointment": "appointment must exist and be booked -> else not_found; new slot must be open -> else unavailable/conflict",
    "cancel_appointment": "appointment must exist and be booked -> else not_found; sets status cancelled",
    "block_card": "card must belong to customer -> else not_found; already blocked -> conflict; sets status blocked and replacement",
    "create_ticket": "category must be in taxonomy -> else invalid_argument; returns ticket_id T-5xxx",
    "request_handoff": "always succeeds; ends the episode after one more assistant turn",
    "idempotency": "a repeated idempotency_key returns the original result without a second write",
    "timeout_injection": "scenario.inject marks the n-th call of a tool to return {error:'timeout'} without applying any write"
  }
