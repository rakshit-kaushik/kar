{
  "type": "function",
  "function": {
    "name": "check_availability",
    "description": "Open 30-minute slots at a branch for a service on a date.",
    "parameters": {
      "type": "object",
      "properties": {
        "branch_id": {
          "type": "string",
          "enum": [
            "market_st",
            "marlow_st",
            "marker_st",
            "mill_rd"
          ]
        },
        "service_type": {
          "type": "string",
          "enum": [
            "account_opening",
            "mortgage_consultation",
            "loan_application",
            "financial_review",
            "notary",
            "safe_deposit_box"
          ]
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        }
      },
      "required": [
        "branch_id",
        "service_type",
        "date"
      ]
    }
  }
}
