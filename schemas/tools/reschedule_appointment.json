{
  "type": "function",
  "function": {
    "name": "reschedule_appointment",
    "description": "Move an existing appointment to a new slot after read-back confirmation. Errors: not_found, conflict, unavailable, timeout.",
    "parameters": {
      "type": "object",
      "properties": {
        "appointment_id": {
          "type": "string",
          "description": "From lookup_account"
        },
        "new_slot_start": {
          "type": "string",
          "description": "YYYY-MM-DDTHH:MM local"
        }
      },
      "required": [
        "appointment_id",
        "new_slot_start"
      ],
      "additionalProperties": false
    }
  }
}
