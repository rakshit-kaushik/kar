{
  "type": "function",
  "function": {
    "name": "block_card",
    "description": "Permanently block a card after explicit confirmation; a replacement can be requested. Errors: not_found, conflict (already blocked), timeout.",
    "parameters": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string",
          "description": "From lookup_account"
        },
        "card_last4": {
          "type": "string",
          "description": "Four digits"
        },
        "reason": {
          "type": "string",
          "description": "Why",
          "enum": [
            "lost",
            "stolen",
            "damaged"
          ]
        },
        "replacement": {
          "type": "string",
          "description": "Shipping",
          "enum": [
            "none",
            "standard",
            "express"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "description": "Caller-generated UUID; repeat returns the original result"
        }
      },
      "required": [
        "customer_id",
        "card_last4",
        "reason",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  }
}