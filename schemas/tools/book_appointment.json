{
  "type": "function",
  "function": {
    "name": "book_appointment",
    "description": "Book a slot from check_availability after the caller confirmed the read-back.",
    "parameters": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string",
          "enum": [
            "market_st",
            "marlow_st",
            "marker_st",
            "mill_rd"
          ]
        },
        "service_type": {
          "type": "string",
          "enum": [
            "account_opening",
            "mortgage_consultation",
            "loan_application",
            "financial_review",
            "notary",
            "safe_deposit_box"
          ]
        },
        "slot_start": {
          "type": "string",
          "description": "YYYY-MM-DDTHH:MM"
        },
        "idempotency_key": {
          "type": "string",
          "description": "new UUID per write"
        }
      },
      "required": [
        "customer_id",
        "branch_id",
        "service_type",
        "slot_start",
        "idempotency_key"
      ]
    }
  }
}
